# Wallet / Auth
PRIVATE_KEY=
POLYMARKET_ADDRESS=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# CLOB API (L2 auth)
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# Builder API (Optional)
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=
