MAX_BET_MODE=pct
MAX_BET_PCT=5.0
MAX_BET_USD=25.0
MAX_DAILY_LOSS_USD=20.0

# Odds / Bounds
MIN_ODDS=0.40
MAX_ODDS=0.65
ALLOW_OUT_OF_BOUND_EV=true
