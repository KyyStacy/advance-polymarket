# ===== Wallet / Auth =====
PRIVATE_KEY=
POLYMARKET_ADDRESS=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Builder credentials (CLOB API creds)
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=

# Signature type:
# 0 = EOA (pure private key, no proxy)
# 1 = POLY_PROXY (browser proxy wallet, MetaMask login)
# 2 = POLY_GNOSIS_SAFE (Polymarket Gnosis Safe — Phantom/email/Magic.link login)
SIGNATURE_TYPE=1
CHAIN_ID=137
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# ===== Mode =====
DRY_RUN=true

# ===== Risk / Sizing =====
MIN_BET_USD=2
# MAX_BET_MODE: pct or usd
MAX_BET_MODE=pct
MAX_BET_PCT=5
MAX_BET_USD=25
MAX_DAILY_LOSS_USD=20

# ===== Odds Bounds =====
MIN_ODDS=0.40
MAX_ODDS=0.65
# Allow entry outside [MIN_ODDS, MAX_ODDS] if EV strong (mispricing override).
# EV_OVERRIDE_MIN_EDGE is the minimum edge required for out-of-bounds entries
# (ask < MIN_ODDS or ask > MAX_ODDS). Raised from 0.08 → 0.20 because extreme-
# price entries (ask < 0.15) have thin books with 15-25% slippage that destroys
# any edge unless the signal is truly exceptional.
ALLOW_OUT_OF_BOUND_EV=true
EV_OVERRIDE_MIN_EDGE=0.20

# ===== Strategy Tuning =====
# Minimum probability edge over implied to enter (in [0,1])
MIN_EDGE=0.04
# Minimum sub-minute momentum z-score (Binance+Coinbase).
# Raised from 1.5 → 2.0: in live trading, Gnosis Safe fills take 0.5-3s.
# By the time the fill lands, a z=1.5 signal has often already reversed.
# z=2.0 filters out noise reversals and requires real directional conviction.
# Note: ask < 0.15 requires z >= 2.5 (hardcoded in entry_engine.py) to
# additionally guard against thin-book slippage at extreme prices.
MIN_MOMENTUM_Z=2.0
# Minimum lead-lag deviation in basis points between CEX vs oracle
MIN_LEADLAG_BPS=2
# Earliest seconds-into-window we will enter (avoid noise at open)
ENTRY_WINDOW_START_SEC=60
# Latest seconds-into-window we will enter (must beat resolution lag)
ENTRY_WINDOW_END_SEC=270
# Exit if remaining time < this and edge gone
EXIT_HARD_FLOOR_SEC=15
# Slow-leg BTC oracle = Polymarket RTDS Chainlink stream (wss://ws-live-data.polymarket.com).
# Hardcoded in code; no env config needed — same Chainlink feed Polymarket resolves on.
# Polygon RPC — only used for on-chain CTF auto-claim (redeemPositions).
POLYGON_RPC=https://polygon-bor-rpc.publicnode.com,https://polygon.llamarpc.com

# Polymarket WS (CLOB market channel is public)
POLYMARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
