# ===== Wallet / Auth =====
PRIVATE_KEY=
POLYMARKET_ADDRESS=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# CLOB API credentials (derived via code — L2 auth on /order endpoint)
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# Builder API credentials (for fee attribution via builder_code field)
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=
# Builder code (bytes32 hex from Polymarket portal — required for fee attribution)
BUILDER_CODE=

# Only signature_type=3 (POLY_1271/deposit wallet) is supported
SIGNATURE_TYPE=3
CHAIN_ID=137
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# ===== Mode =====
DRY_RUN=true

# ===== Risk / Sizing =====
MIN_BET_USD=2
# MAX_BET_MODE: pct or usd
MAX_BET_MODE=pct
MAX_BET_PCT=5
MAX_BET_USD=25
MAX_DAILY_LOSS_USD=20

# ===== Odds Bounds =====
MIN_ODDS=0.40
MAX_ODDS=0.65
# Allow entry outside MIN_ODDS/MAX_ODDS if EV strong (mispricing override)
ALLOW_OUT_OF_BOUND_EV=true
# Minimum edge required for out-of-bounds entries (ask < MIN_ODDS or ask > MAX_ODDS)
EV_OVERRIDE_MIN_EDGE=0.20

# ===== Strategy Tuning =====
MIN_EDGE=0.04
MIN_MOMENTUM_Z=2.0
MIN_LEADLAG_BPS=2
ENTRY_WINDOW_START_SEC=60
ENTRY_WINDOW_END_SEC=270
EXIT_HARD_FLOOR_SEC=15
# Polygon RPC (for on-chain operations)
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polymarket WS (CLOB market channel is public)
POLYMARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
